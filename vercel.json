{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/links",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/links/:path*",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/quoterevive",
      "destination": "https://quoterevivepro.vercel.app",
      "permanent": false
    },
    {
      "source": "/quoterevive/:path*",
      "destination": "https://quoterevivepro.vercel.app",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brimful",
      "destination": "https://www.brimful.tech",
      "permanent": false
    },
    {
      "source": "/brimful/:path*",
      "destination": "https://www.brimful.tech",
      "permanent": false
    },
    {
      "source": "/marketing/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/((?!admin|api).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-15YfT0pxIplPCqnYtfvxwYYbxIsi9NOyJNkxnFmnzUY=' 'sha256-1CVOqTTJT3X6CexHUtk+02EeYrH70xpkz02l+S2iFO4=' 'sha256-5y/QojFqIwqT+1xuIzoLFyNMd7op7rOqIAMoGsx8r0U=' 'sha256-CRPrtL1VWSIgAkQ9IVIw6HHvN9QM73epI1CSLdcJeQI=' 'sha256-FRGVdHQ1C8FcwGyrEjwY0tW3qvBct+G6YNEhP2pYi14=' 'sha256-ItkHUjfM6Kb5Dd73CtRYmU+0uReWbsp0aHs5UqIpF6o=' 'sha256-kWoSoZ57LRstJK1+VAjYtOCCs5mnw5ovzleuxxuUC6E=' 'sha256-q5xGwLgfFiJ6m6MPfOLushibrEmFQXZroN9AGy+dkXc=' 'sha256-qOsXYyI43DSLwOstGOnBCgWrUJwYm+dMLoFjdYYqLL8=' 'sha256-ugc6u2OQPE2CvdmGV0A41onguSd+4KzjzkUxIoAFbY4='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/store/:product/shared/:id/:sub/:subid",
      "destination": "/api/store/shared?product=:product&id=:id&sub=:sub&subid=:subid"
    },
    {
      "source": "/api/store/:product/shared/:id/:sub",
      "destination": "/api/store/shared?product=:product&id=:id&sub=:sub"
    },
    {
      "source": "/api/store/:product/shared/:id",
      "destination": "/api/store/shared?product=:product&id=:id"
    },
    {
      "source": "/api/store/:product/shared",
      "destination": "/api/store/shared?product=:product"
    },
    {
      "source": "/api/store/:product/orders/:key",
      "destination": "/api/store/order?product=:product&key=:key"
    },
    {
      "source": "/api/store/:product/orders",
      "destination": "/api/store/order?product=:product"
    },
    {
      "source": "/api/store/:product/backup/:id",
      "destination": "/api/store/backup?id=:id"
    },
    {
      "source": "/api/store/:product",
      "destination": "/api/store/product?product=:product"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "17 3 * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
