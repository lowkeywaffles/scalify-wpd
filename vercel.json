{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/links",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/links/:path*",
      "destination": "/products",
      "permanent": false
    },
    {
      "source": "/quoterevive",
      "destination": "https://quoterevivepro.vercel.app",
      "permanent": false
    },
    {
      "source": "/quoterevive/:path*",
      "destination": "https://quoterevivepro.vercel.app",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/brimful",
      "destination": "https://www.brimful.tech",
      "permanent": false
    },
    {
      "source": "/brimful/:path*",
      "destination": "https://www.brimful.tech",
      "permanent": false
    },
    {
      "source": "/marketing/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/tests/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/((?!admin|api).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-1CVOqTTJT3X6CexHUtk+02EeYrH70xpkz02l+S2iFO4=' 'sha256-5iZJpilXo3+p9bp8lo0dnMyeh9iIAy0WcFx0bM+A93A=' 'sha256-AbgZneOU05mcHLsE4BCBWBgFWGKX36RqaQ372mrI0SU=' 'sha256-IRkOZ6WXa1ttLuwK2u277xfKhBVCUSasaELAQsBlGtc=' 'sha256-UlfCEuIUTW8bqSyXuEXvVq0ShiR+XTK5rlluL4cq3y0=' 'sha256-cz1RSkcZq1gtRHhzl7fvsfYv03BLNvLqn6fYLUj4s+o=' 'sha256-lGlhdILBh6nc7s2Oa/WmG9aCNEJ85sRgWlqWrpnyeYw=' 'sha256-mCffrd5zmuZ79qlAIHOYXj1RpLLRCspcmUTEgl7rRHI=' 'sha256-ugc6u2OQPE2CvdmGV0A41onguSd+4KzjzkUxIoAFbY4=' 'sha256-wk6xvThgB3pCpN1cq7P4UmQ4aW1fA3Iav/1YH5mX2fQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/store/:product/shared/:id/:sub/:subid",
      "destination": "/api/store/shared?product=:product&id=:id&sub=:sub&subid=:subid"
    },
    {
      "source": "/api/store/:product/shared/:id/:sub",
      "destination": "/api/store/shared?product=:product&id=:id&sub=:sub"
    },
    {
      "source": "/api/store/:product/shared/:id",
      "destination": "/api/store/shared?product=:product&id=:id"
    },
    {
      "source": "/api/store/:product/shared",
      "destination": "/api/store/shared?product=:product"
    },
    {
      "source": "/api/store/:product/orders/:key",
      "destination": "/api/store/order?product=:product&key=:key"
    },
    {
      "source": "/api/store/:product/orders",
      "destination": "/api/store/order?product=:product"
    },
    {
      "source": "/api/store/:product/backup/:id",
      "destination": "/api/store/backup?id=:id"
    },
    {
      "source": "/api/store/:product",
      "destination": "/api/store/product?product=:product"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "17 3 * * *"
    }
  ],
  "regions": [
    "fra1"
  ]
}
