# Public (sent to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Server only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
WHOP_API_KEY=
WHOP_PRODUCT_ID=prod_xxx
# The $39 one-time plan (pricing option) of that product
WHOP_PLAN_ID=plan_xxx
# Your Whop business id (in the dashboard URL)
WHOP_ACCOUNT_ID=biz_xxx
WHOP_WEBHOOK_SECRET=ws_xxx
# Use https://sandbox-api.whop.com while testing
WHOP_API_BASE=https://api.whop.com
CRON_SECRET=generate-a-long-random-string
