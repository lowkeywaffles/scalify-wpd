    {"id": "10", "start": 21.9, "end": 26.8, "text": "Every morning, see exactly who to chase today."},
    {"id": "11", "start": 27.3, "end": 33.0, "text": "Pick a tone, your message is ready. Send it from your own WhatsApp."},
    {"id": "12", "start": 33.5, "end": 38.6, "text": "Your client taps accept... and the deal is back on."},
    {"id": "13", "start": 39.1, "end": 43.6, "text": "Stop losing clients to silence. Start free with QuoteRevive. Link in bio."}
